<?xml version="1.0" encoding="utf-8"?>
<!--
    Physical lever thumb.

    Because the SeekBar is rotated 270°, drawable width/height are swapped visually:
      android:width  = 28dp  →  visual HEIGHT of thumb after rotation
      android:height = 54dp  →  visual WIDTH  of thumb after rotation

    Result: a 54×28dp rectangular handle, wider than the track — just like a
    real railway throttle lever.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#851616"/>
            <stroke android:width="2dp" android:color="#B2B2B2"/>
            <corners android:radius="5dp"/>
            <size android:width="28dp" android:height="54dp"/>
        </shape>
    </item>
    <!-- Centre grip line -->
    <item
        android:top="10dp"
        android:bottom="10dp"
        android:left="12dp"
        android:right="12dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/readoutColor"/>
            <corners android:radius="1dp"/>
        </shape>
    </item>
</layer-list>
