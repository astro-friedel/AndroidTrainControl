<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@color/background"
    android:padding="24dp">

    <!-- Panel header label -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:fontFamily="monospace"
        android:letterSpacing="0.25"
        android:text="@string/speed_controller_title"
        android:textColor="#AB5EF9"
        android:textSize="25sp" />

    <!-- Digital speed display box -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="8dp">

        <!-- 7-segment-style speed readout (styled via SpannableString in Java) -->
        <TextView
            android:id="@+id/tv_speed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/digital_7_mono"
            android:includeFontPadding="false"
            android:text="@string/_000"
            android:textColor="@color/readoutColor"
            android:textSize="82sp" />

    </LinearLayout>

    <!-- Lever: scale labels + vertical SeekBar -->
    <!-- android:clipChildren="false" lets the rotated SeekBar render outside its layout bounds -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:clipChildren="false"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp">

        <LinearLayout
            android:layout_width="36dp"
            android:layout_height="230dp"
            android:orientation="vertical"
            android:paddingTop="0dp"
            android:paddingBottom="15dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:fontFamily="monospace"
                android:gravity="bottom|end"
                android:text="@string/_100"
                android:textColor="#AB5EF9"
                android:textSize="16sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="15dp"
                android:layout_weight="1"
                android:fontFamily="monospace"
                android:gravity="bottom|end"
                android:text="@string/_75"
                android:textColor="#AB5EF9"
                android:textSize="16sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="15dp"
                android:layout_weight="1"
                android:fontFamily="monospace"
                android:gravity="bottom|end"
                android:text="@string/_50"
                android:textColor="#AB5EF9"
                android:textSize="16sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="15dp"
                android:layout_weight="1"
                android:fontFamily="monospace"
                android:gravity="bottom|end"
                android:text="@string/_25"
                android:textColor="#AB5EF9"
                android:textSize="16sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="15dp"
                android:layout_weight="1"
                android:fontFamily="monospace"
                android:gravity="bottom|end"
                android:text="@string/_0"
                android:textColor="#AB5EF9"
                android:textSize="16sp" />
        </LinearLayout>

        <!-- SeekBar container.
             Width = 58dp (visual width of lever after rotation).
             Height = 230dp (visual height / travel of lever). -->
        <FrameLayout
            android:id="@+id/speed_slider"
            android:layout_width="58dp"
            android:layout_height="230dp"
            android:clipChildren="false"
            android:paddingBottom="5dp">

            <!--
                The SeekBar is rotated 270° to make it vertical.
                After rotation:  left-edge (progress=0)  → visual BOTTOM
                                 right-edge (progress=100) → visual TOP
                layout_width  becomes the visual HEIGHT (230dp track travel).
                layout_height becomes the visual WIDTH  (58dp = thumb height area).
                thumbOffset   = half thumb height (54dp / 2 = 27dp) so thumb
                                centres on the track ends correctly.
            -->
            <SeekBar
                android:id="@+id/sb_speed"
                android:layout_width="230dp"
                android:layout_height="58dp"
                android:layout_gravity="center"
                android:max="100"
                android:paddingStart="30dp"
                android:paddingEnd="0dp"
                android:progress="0"
                android:progressDrawable="@drawable/speed_control_trackbar"
                android:rotation="270"
                android:thumb="@drawable/speed_control_thumb"
                android:thumbOffset="27dp" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="10dp"
            android:paddingEnd="0dp">

            <TextView
                android:id="@+id/speed_direction"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/dir"
                android:textColor="#AB5EF9"
                android:textSize="16sp" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/direction_switch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:thumb="@drawable/speed_control_thumb" />
        </LinearLayout>
    </LinearLayout>

    <!-- STOP button -->
    <Button
        android:id="@+id/btn_stop"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:text="@string/stop"
        android:textColor="@color/readoutColor"
        android:textSize="30sp"
        android:letterSpacing="0.3"
        android:fontFamily="monospace"
        android:background="@drawable/speed_control_stop"
        android:paddingTop="5dp"
        android:paddingBottom="5dp"
        android:stateListAnimator="@null"/>

</LinearLayout>